PORT=3000
# Use the same secret after restart to preserve existing login cookies.
# Generate one: node -e "console.log(require('node:crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=replace-this-with-a-random-secret-of-at-least-32-characters
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
SESSION_TTL_MS=86400000
WIN_SCORE=7
# DB_PATH=data/rally.sqlite
# For HTTPS behind exactly one trusted reverse proxy:
# NODE_ENV=production
# TRUST_PROXY=1
# ALLOWED_ORIGINS=https://pong.example.com
